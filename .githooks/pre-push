#!/bin/bash
# Pre-push hook — refuses direct pushes to protected branches (main, develop).
# Backs up the pre-commit hook for cases where commits land on a protected
# branch via merge/rebase rather than direct commit.
#
# Bypass for emergencies (rare, deliberate): git push --no-verify

set -e

PROTECTED_BRANCHES="^(main|develop)$"
zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')

while read -r local_ref local_sha remote_ref remote_sha; do
  remote_branch="${remote_ref#refs/heads/}"
  if [[ "$remote_branch" =~ $PROTECTED_BRANCHES ]]; then
    # Allow branch deletion (local_sha == zero) — handled by GitHub side normally
    if [ "$local_sha" != "$zero" ]; then
      echo ""
      echo "❌ Direct push to '$remote_branch' refused by pre-push hook."
      echo ""
      echo "Use git-flow or open a PR:"
      echo "  git flow feature start <name>          # for new work"
      echo "  git flow release start <version>        # for releases"
      echo "  git flow hotfix start <version>         # for hotfixes"
      echo ""
      echo "Then merge via PR:"
      echo "  git push origin <your-branch>"
      echo "  gh pr create --base $remote_branch"
      echo ""
      echo "Emergency bypass (use sparingly):"
      echo "  git push --no-verify"
      echo ""
      exit 1
    fi
  fi
done

exit 0
